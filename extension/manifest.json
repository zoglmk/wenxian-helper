{
  "name": "文献助手",
  "version": "1.3.0",
  "manifest_version": 3,
  "description": "知网文献与 ProQuest 公开学位论文 PDF 批量下载助手",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "downloads",
    "activeTab",
    "scripting",
    "sidePanel",
    "webNavigation"
  ],
  "host_permissions": [
    "*://*.cnki.net/*",
    "*://*.edu.cn/*",
    "*://api.unpaywall.org/*",
    "*://sci.bban.top/*",
    "*://www.proquest.com/*",
    "*://proquest.com/*",
    "*://media.proquest.com/*"
  ],
  "optional_host_permissions": ["*://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel/index.html"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.cnki.net/*",
        "*://*.edu.cn/*"
      ],
      "js": ["content/main.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["*://www.proquest.com/*", "*://proquest.com/*"],
      "js": ["proquest.js", "content/proquest.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "文献助手",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
